# Copy to .env and edit. All secrets live here, never in the database.
# Every registrar and notification channel is optional: leave it empty to disable it.

# ---------------------------------------------------------------- app
# Public URL (https:// enables secure cookies)
BASE_URL=http://localhost:8080
HOST_PORT=8080
# Initial admin, created only when the database has no users yet
# (leave empty to create the first admin on the /setup page)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# true behind a reverse proxy that sets X-Forwarded-For (EasyPanel: true)
TRUST_PROXY=false
#SECURE_COOKIES=true
LOG_LEVEL=info

# Rehearsal mode: drop-catch sessions run, but no real orders are placed
# (Porkbun uses its official dryRun option; other registrars are simulated).
ORDERS_DRY_RUN=false

# ---------------------------------------------------------------- WHOIS/RDAP service
# docker compose wires the sidecar automatically (http://whois)
#WHOIS_URL=http://whois
# Optional shared secret for the sidecar API (its SITE_PASSWORD)
WHOIS_PASSWORD=
# User-Agent the sidecar uses for web-based WHOIS lookups (empty = upstream default)
WHOIS_USER_AGENT=
# External deployments of the same whois-domain-lookup program (same JSON API),
# comma-separated. Tried in order when the internal sidecar fails or is
# rate-limited for a suffix, before Cloudean/Regery and registrar APIs.
# Append "|password" to an entry if that instance has a SITE_PASSWORD.
EXTERNAL_WHOIS_API_ENDPOINTS=

# ---------------------------------------------------------------- registrant contact
# Used by registrars that need contact data inline (Dynadot without
# DYNADOT_CONTACT_ID, Internet.bs without INTERNETBS_CLONE_CONTACTS_FROM).
# Phone format: +<country code>.<number>, e.g. +1.5555555555
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_ORGANIZATION=
REGISTRANT_EMAIL=
REGISTRANT_PHONE=
REGISTRANT_STREET=
REGISTRANT_STREET2=
REGISTRANT_CITY=
REGISTRANT_STATE=
REGISTRANT_POSTAL_CODE=
# ISO 3166-1 alpha-2, e.g. US, DE, LU
REGISTRANT_COUNTRY=

# ---------------------------------------------------------------- Dynadot (RESTful API v2)
# Dynadot > Tools > API: API key + secret (secret signs register calls).
# Whitelist the server IP there. Orders are paid from the account balance.
DYNADOT_API_KEY=
DYNADOT_API_SECRET=
# Use https://api-sandbox.dynadot.com (sandbox key/secret)
DYNADOT_SANDBOX=false
# Existing contact id used for registrant/admin/tech/billing (else REGISTRANT_*)
DYNADOT_CONTACT_ID=
# off | partial | full
DYNADOT_PRIVACY=full
DYNADOT_CURRENCY=usd

# ---------------------------------------------------------------- Porkbun (API v3)
# Keys need the "read" and "purchase" scopes; account email+phone verified;
# prepaid credit must cover the order. Premium names cannot be bought via API.
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
PORKBUN_WHOIS_PRIVACY=true

# ---------------------------------------------------------------- Internet.bs
# The API key is bound to the server IP. Orders are debited from the prepaid balance.
INTERNETBS_API_KEY=
INTERNETBS_PASSWORD=
# Use https://testapi.internet.bs (test credentials: testapi / testpass)
INTERNETBS_TEST=false
# A domain in your account whose contacts are cloned (recommended: same TLD).
# Empty = REGISTRANT_* is used for all four contacts.
INTERNETBS_CLONE_CONTACTS_FROM=
# FULL | PARTIAL | DISABLE (empty = registrar default)
INTERNETBS_PRIVATE_WHOIS=

# ---------------------------------------------------------------- Netim (REST API 1.0)
# Reseller id + API (DAS) password from Netim Direct > API - DAS - OTE.
NETIM_ID=
NETIM_PASSWORD=
# Use the OT&E test platform
NETIM_OTE=false
# Contact handles that exist in your Netim account. The owner must be an
# "owner" contact (isOwner=1); admin/tech/billing default to NETIM_ID.
NETIM_OWNER_ID=
NETIM_ADMIN_ID=
NETIM_TECH_ID=
NETIM_BILLING_ID=
# Optional comma-separated nameservers (default: your Netim DNS template)
NETIM_NAMESERVERS=

# ---------------------------------------------------------------- Cloudflare Registrar API (beta)
# API token with Registrar write permission. Charged to the account's default
# payment method; a default registrant contact must exist in the dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------- Regery API
# https://regery.com/partnership/api/ - Control panel > Account > API Access.
# Sent as "Authorization: API_KEY:API_SECRET". Orders are paid from the
# account balance. Test keys start with TST_ and only accept domain names that
# contain the test domain token (e.g. dctest-<token>.com); use them with the
# test phone number. Remove the REGERY_TEST_* lines with a live key.
REGERY_API_KEY=
# the "API key secret"
REGERY_API_SECRET=
# test mode only: "test domain token" and "test phone number" from Regery
REGERY_TEST_DOMAIN_TOKEN=
REGERY_TEST_PHONE=
# Existing contact id for the registrant; empty = REGISTRANT_* is saved via
# POST /v1/contacts on the first order. Regery requires REGISTRANT_STATE
# (sent as COUNTRY_STATE, e.g. CA_ON / US_NY).
REGERY_CONTACT_ID=
# Optional comma-separated nameservers (empty = Regery default "basic")
REGERY_NAMESERVERS=
# Optional contact services, comma-separated: proxy, trustedRegistrant, trustedAdmin, trustedTech
REGERY_SERVICES=

# ---------------------------------------------------------------- NameSilo
# Account > API Manager. Optionally restrict the key to the server IP there.
# Orders are paid from account funds. A sandbox account is available on request.
NAMESILO_API_KEY=
# Contact profile id (contactList); empty = REGISTRANT_* sent inline, falling
# back to the account's default contact profile
NAMESILO_CONTACT_ID=
NAMESILO_PRIVATE=true
# Optional comma-separated nameservers (must exist at the registry)
NAMESILO_NAMESERVERS=

# ---------------------------------------------------------------- Spaceship
# https://www.spaceship.com/application/api-manager/ - scopes needed:
# domains:read, domains:billing, contacts:read, contacts:write, asyncoperations:read.
# Registrations are async (polled) and charged to the Spaceship account.
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
# Contact id used for registrant/admin/tech/billing (see an existing domain's
# contacts); empty = REGISTRANT_* is saved via PUT /v1/contacts on first order
SPACESHIP_CONTACT_ID=
SPACESHIP_PRIVACY=true

# ---------------------------------------------------------------- Twilio voice calls (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164 (+15551234567)
TWILIO_FROM=
# Comma-separated numbers to call, E.164
TWILIO_TO=

# ---------------------------------------------------------------- Telegram bot (optional)
# Create a bot with @BotFather; send it a message, then find your chat id
# via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids (users or groups)
TELEGRAM_CHAT_IDS=
